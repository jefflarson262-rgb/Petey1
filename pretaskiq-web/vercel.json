{
  "functions": {
    "api/claude.js": { "maxDuration": 60 },
    "api/speak.js": { "maxDuration": 30 },
    "api/transcribe.js": { "maxDuration": 45 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
