# Copy this file to .env.local for `npm run dev`. On Vercel, enter the same names under Settings > Environment Variables.
# Never commit the real values, and never paste them into a chat.

# --- Required ---
ANTHROPIC_API_KEY=            # from the Claude Console (platform.claude.com/settings/keys); starts with sk-ant-

# --- Sign-in with Supabase (recommended; see README). Set all three, or none. ---
SUPABASE_URL=                 # Project URL, like https://abcdefgh.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # "Publishable" key (starts with sb_publishable_). Safe for browsers.
SUPABASE_SECRET_KEY=          # "Secret" key (starts with sb_secret_). SERVER ONLY. Never share it.

# --- Only if the three Supabase settings above are empty: a shared access code ---
ACCESS_CODE=

# --- Optional: a natural-sounding voice for Petey, and more reliable listening on iPhones (ElevenLabs). Costs money, and Petey's words and
#     recordings of people's answers go to ElevenLabs (see README section 3). Leave empty to keep the browser's own voice and listening. ---
ELEVENLABS_API_KEY=           # an API key from your ElevenLabs account. SERVER ONLY. Never share it.
# ELEVENLABS_VOICE_ID=        # the ID of the voice you want. Leave empty for the default ("Brian", male, American accent; see README section 3 for other options).
# ELEVENLABS_MODEL_ID=        # leave empty for the default (eleven_flash_v2_5)
# ELEVENLABS_STT_MODEL_ID=    # the speech-to-text model used for iPhone listening; leave empty for the default (scribe_v2)

# --- Optional ---
# ANTHROPIC_MODEL=            # leave empty to use the default
# AI_CALLS_PER_HOUR=150       # per-person limit on AI requests when Supabase sign-in is on
